{
  "name": "touchgrass-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "deploy": "node scripts/with-env.mjs TG_AI=1 -- npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "predev": "node scripts/migrate-local.mjs",
    "db:reset:local": "wrangler d1 execute DB --local --command \"DELETE FROM events; DELETE FROM profiles;\"",
    "dev:ai": "node scripts/with-env.mjs TG_AI=1 -- vite",
    "preview:ai": "node scripts/with-env.mjs TG_AI=1 -- npm run build && node scripts/with-env.mjs TG_AI=1 -- vite preview",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
