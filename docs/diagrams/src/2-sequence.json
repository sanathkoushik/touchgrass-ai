  "cards": [
    {
      "dot": "emerald",
      "title": "Why two steps",
      "items": [
        "The engine answers in about 0.8 s; the AI usually needs 2 to 3 s more",
        "So the screen never waits on the AI",
        "Each recommendation gets one upgrade attempt, which protects the free quota"
      ]
    },
    {
      "dot": "rose",
      "title": "What the AI cannot do",
      "items": [
        "Pick anything outside the top 3 candidates the engine chose",
        "Change the title, the duration or who you go with",
        "Invent history, numbers, links or feelings: such replies are rejected"
      ]
    },
    {
      "dot": "cyan",
      "title": "If you already tapped Let's go",
      "items": [
        "A late AI upgrade is dropped",
        "The card never changes under someone who has decided"
      ]
    }
