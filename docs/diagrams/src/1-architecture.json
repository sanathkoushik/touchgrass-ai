  "cards": [
    {
      "dot": "emerald",
      "title": "Instant first, smarter second",
      "items": [
        "The screen asks for the engine's pick first, with the AI skipped, and shows it at once",
        "A second background call lets Gemma improve that same recommendation",
        "Measured in a browser: engine pick at about 0.8 s, AI wording at about 2.8 s"
      ]
    },
    {
      "dot": "rose",
      "title": "It never breaks",
      "items": [
        "AI slow (6 s cap), busy, out of free quota or invalid: the engine's pick stays",
        "A circuit breaker skips the AI for a while after a failure",
        "If saving fails, the recommendation is still returned"
      ]
    },
    {
      "dot": "cyan",
      "title": "One project, no cold start",
      "items": [
        "One Cloudflare project serves the React app and the API",
        "Static files are served first; /api/* always runs the Worker",
        "Local dev needs no login; the AI is switched on only for dev:ai and deploy"
      ]
    },
    {
      "dot": "amber",
      "title": "Your data",
      "items": [
        "No accounts: a random id per browser, stored on the server only as a SHA-256 hash",
        "The AI gets a few anonymous facts (your chosen interests, time and energy), never ids",
        "Delete my data removes your profile and history"
      ]
    }
  ]
